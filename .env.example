# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# Leave DATABASE_URL empty for LOCAL development (uses SQLite automatically).
# For PRODUCTION, add your PostgreSQL connection string:
#   - Supabase (free):  https://supabase.com  → postgresql://...
#   - Neon (free):      https://neon.tech     → postgresql://...
#   - Render Postgres:  https://render.com    → postgresql://...
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Default admin (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ─────────────────────────────────────────────
# CORS — your Surge website domain(s)
# Comma-separated, or * to allow all
# Example: CORS_ORIGIN=https://my-site.surge.sh
# ─────────────────────────────────────────────
CORS_ORIGIN=*

# ─────────────────────────────────────────────
# Display
# ─────────────────────────────────────────────
SITE_NAME=My Website
